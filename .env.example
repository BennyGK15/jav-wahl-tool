# Kopieren nach .env.local und Werte ersetzen. Nie einchecken.

# Datenbank (eigener Benutzer mit minimalen Rechten, nicht root)
DATABASE_URL=mysql://jav_app:BITTE_AENDERN@127.0.0.1:3306/jav_wahl
# true, sobald die DB über TLS erreichbar ist (Pflicht im Produktivbetrieb)
DB_SSL=false

# better-auth: Secret mit `openssl rand -base64 32` erzeugen
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Schlüssel für die Feldverschlüsselung (AES-256-GCM), 32 Byte Base64:
# `openssl rand -base64 32`. Getrennt vom Backup aufbewahren!
DATA_ENCRYPTION_KEY=
